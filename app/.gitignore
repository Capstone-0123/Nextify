# 의존성 모듈 (가장 중요)
node_modules/

# Lock 파일 (npm만 사용)
yarn.lock
pnpm-lock.yaml

# 로그 파일들
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs
*.log

# 운영체제 파일 (Mac/Windows)

.DS_Store
Thumbs.db

# 에디터 설정 파일 (VSCode, IntelliJ 등 - 선택사항)

.idea/
.vscode/
*.swp

# 로컬 환경 변수 (사용한다면)

.env
.env.local

# 테스트 실행 시 생성되는 폴더들 (혹시 테스트용으로 만들었다면)

dist/
coverage/
test-results/

# CLI 동작 테스트를 위해 내부에 만든 임시 프로젝트들이 있다면 제외

my-test-app/
temp/