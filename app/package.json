{
  "name": "nextify-cli",
  "version": "0.1.2",
  "description": "CLI tool for migrating React (Vite) projects to Next.js",
  "license": "MIT",
  "bin": {
    "migrate-next": "cli.cjs"
  },
  "type": "commonjs",
  "files": [
    "cli.cjs",
    "src",
    "CHANGELOG.md"
  ],
  "keywords": [
    "nextjs",
    "react",
    "vite",
    "migration",
    "cli"
  ],
  "homepage": "https://github.com/Capstone-0123/Nextify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Capstone-0123/Nextify.git"
  },
  "bugs": {
    "url": "https://github.com/Capstone-0123/Nextify/issues"
  },
  "publishConfig": {
